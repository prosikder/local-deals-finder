# Example Keystore Properties Template
# Copy this file to 'keystore.properties' (which is git-ignored) and populate with your production release signing key details.
#
# Play App Signing Recommendation:
# Google Play recommends generating an upload key and letting Google Play manage your app signing key.
#
# To generate an upload key with keytool:
# keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
storeFile=../upload-keystore.jks
storePassword=your_store_password_here
keyAlias=upload
keyPassword=your_key_password_here
